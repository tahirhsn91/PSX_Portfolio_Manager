# =============================================================================
# PSX Portfolio Manager — Environment Variables
#
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed.
#
# Quick start (your PSX scraper — best quality):
#   1. cp .env.example .env.local
#   2. Set VITE_MARKET_PROVIDER=psx
#   3. Set VITE_PSX_SCRAPER_URL to your scraper's base URL
#   4. docker compose --profile dev up --build
#
# Quick start (Yahoo Finance — free, no setup):
#   1. cp .env.example .env.local
#   2. Set VITE_MARKET_PROVIDER=yahoo
#   3. docker compose --profile dev up --build
#
# Quick start (mock data — works fully offline):
#   docker compose --profile dev up --build   (no .env.local needed)
# =============================================================================

# ── Market data provider ──────────────────────────────────────────────────────
#
# "psx"          — Custom PSX Scraper API (self-hosted, recommended)
#                  Requires VITE_PSX_SCRAPER_URL. Only tracked stocks return data;
#                  untracked symbols are auto-added on first access.
# "yahoo"        — Yahoo Finance (FREE, browser-direct, 15-min delayed, no key)
#                  Coverage: all PSX-listed symbols (.KA suffix)
# "capitalstake" — Capital Stake live PSX data (paid, requires key below)
# "mock"         — Built-in deterministic seed data (default, works offline)
#
VITE_MARKET_PROVIDER=mock

# ── PSX Scraper URL (VITE_MARKET_PROVIDER=psx) ───────────────────────────────
#
# Informational only: the app never requests this URL. Scraper calls go through the
# backend proxy's /api/psx/* path, and the proxy holds the real PSX_SCRAPER_URL
# server-side. This value is echoed in one startup console.info().
# Keep it same-origin for a production build so the bundle carries no host-specific URL.
#
VITE_PSX_SCRAPER_URL=/api/psx

# ── Proxy server URL ──────────────────────────────────────────────────────────
#
# Base URL the React app uses to reach the backend proxy.
#
# PRODUCTION: leave EMPTY. Empty means SAME ORIGIN — the app then requests
# /api/auth/*, /api/psx/*, /api/cs/* and /api/sarmaaya/* on whatever host served the
# page, and the frontend image's nginx forwards /api/ to the `proxy-prod` service
# (frontend/nginx/nginx.conf). This is what makes one image work over https and on any
# domain: an absolute base URL is baked in at build time, so from any other origin every
# call is refused before it leaves the browser — mixed content (https page → http URL),
# then no CORS match, then the container's own CSP `connect-src 'self'`.
#
# DEV (Vite dev server — no /api proxy): it must be absolute, e.g.
#   VITE_PROXY_BASE_URL=http://localhost:4000
#
VITE_PROXY_BASE_URL=

# ── Capital Stake API (optional — only needed for VITE_MARKET_PROVIDER=capitalstake)
#
# Sign up at https://www.capitalstake.com to obtain an API key.
# The key is used by the backend proxy and NEVER exposed to the browser.
#
CAPITALSTAKE_API_KEY=

# ── PostgreSQL — auth + portfolio storage ─────────────────────────────────────
#
# Used by both the db-dev / db-prod services and the proxy. Each proxy service
# composes its own DATABASE_URL (host is db-dev / db-prod on the compose
# network), so only these values live here.
#
# POSTGRES_PASSWORD has a dev default; the prod profile REQUIRES a real value.
# JWT_SECRET is required — generate with:  openssl rand -hex 32
#
POSTGRES_USER=psx
POSTGRES_PASSWORD=psx_dev_password
POSTGRES_DB=psx_portfolio
JWT_SECRET=
# Session lifetime for issued JWTs (vercel/ms format, e.g. 7d, 12h)
JWT_EXPIRES_IN=7d
# Set true only when serving over HTTPS (adds Secure to the session cookie)
COOKIE_SECURE=false
# Accounts: closed by default — an admin creates them (see SEED_ADMIN_* below).
# The first account of an empty instance can always register, which is how a host
# deployed without the seed variables is claimed.
ALLOW_PUBLIC_SIGNUP=false
# The initial administrator, created on boot only when the instance has no admin.
# Never commit a real password, and never reuse one that has been typed into a
# chat: this repository is public, so a password written down is a published one.
SEED_ADMIN_EMAIL=superadmin@xyz.com
SEED_ADMIN_PASSWORD=
# Record the client IP on auth events (login, signup). Off by default: it is
# personal data, and the audit trail does not need it to be useful.
RECORD_AUTH_IP=false

# ── Social sign-in (Google / Facebook) ────────────────────────────────────────
#
# A provider with either credential empty is reported as disabled and renders no
# button. Real values belong in .env.local (gitignored, mode 600) — never here.
#
# Google: Cloud Console → APIs & Services → Credentials → OAuth client (Web).
#   Authorized redirect URI:  <OAUTH_CALLBACK_BASE_URL>/google/callback
# Facebook: App → Facebook Login → Settings → Valid OAuth Redirect URIs.
#   Authorized redirect URI:  <OAUTH_CALLBACK_BASE_URL>/facebook/callback
#
# Both providers require an HTTPS redirect URI in production; a bare-IP
# http://host:port is only accepted for localhost development.
#
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_FACEBOOK_APP_ID=
OAUTH_FACEBOOK_APP_SECRET=
# Absolute base the callback is built from, e.g. https://app.example.com/api/auth/oauth
# Leave empty to derive it from the request (fine for local development).
OAUTH_CALLBACK_BASE_URL=
# Provider sign-in may create an account even while ALLOW_PUBLIC_SIGNUP=false.
# This instance is open to anyone with a Google/Facebook account.
OAUTH_SIGNUP=true
# Link a provider identity to an existing account only on a provider-asserted
# verified email. Leave true; setting false refuses linking instead.
OAUTH_LINK_BY_EMAIL=true
# Development only: enables the local "stub" provider so the whole flow can be
# exercised without real credentials. Never enable in production.
OAUTH_STUB_ENABLED=false

# ── Transactional email (password reset) ──────────────────────────────────────
# Resend is used when RESEND_API_KEY is set; otherwise SMTP when SMTP_HOST is.
# With neither, reset links go to the server log (development only — the stub
# refuses to run when NODE_ENV=production).
# MAIL_FROM is required for both real transports, e.g.
#   MAIL_FROM="PSX Portfolio <no-reply@yourdomain.com>"
# Deliverability lives in DNS, not here: publish SPF and DKIM for the sending
# domain and a DMARC policy, or mail lands in spam.
MAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── Future / optional ─────────────────────────────────────────────────────────
# VITE_API_BASE_URL=
# VITE_FIREBASE_API_KEY=
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
