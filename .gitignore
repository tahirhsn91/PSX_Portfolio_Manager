# =============================================================================
# PSX Portfolio Manager — .gitignore
# Monorepo: frontend/ (React/Vite) + backend/ (Node.js proxy)
# =============================================================================

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules
frontend/node_modules
backend/node_modules

# ── Build outputs ─────────────────────────────────────────────────────────────
dist
dist-ssr
frontend/dist
frontend/dist-ssr

# ── Vite cache ────────────────────────────────────────────────────────────────
.vite
frontend/.vite

# ── Logs ─────────────────────────────────────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Environment secrets (never commit) ───────────────────────────────────────
.env.local
.env.*.local
*.local

# ── Docker overrides ─────────────────────────────────────────────────────────
docker-compose.override.yml

# ── Temp / helper scripts ────────────────────────────────────────────────────
restructure.ps1
cleanup.ps1
verify.ps1

# ── Editor / OS artefacts ─────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
