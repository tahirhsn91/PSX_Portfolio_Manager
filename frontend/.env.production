# =============================================================================
# Vite build-time env (production mode) — read by `vite build` inside the image.
#
# Why this file exists: the prod image is built by frontend/Dockerfile, whose
# declared ARGs are VITE_MARKET_API_URL / VITE_MARKET_API_KEY / VITE_API_BASE_URL
# only. The compose build args for VITE_MARKET_PROVIDER and VITE_PROXY_BASE_URL
# are therefore NOT consumed, and Vite has no other way to see them. Vite reads
# .env.production from the project root during `npm run build`, and this file is
# copied into the build context (frontend/.dockerignore excludes .env, .env.local
# and *.local — but not .env.production).
# =============================================================================

VITE_MARKET_PROVIDER=psx
# Scraper REST API base (JSON). Requests never use this value — the frontend always
# calls its own backend proxy's /api/psx/* path — it is only echoed in one startup
# console.info(). Kept same-origin so the built bundle carries no host-specific URL.
VITE_PSX_SCRAPER_URL=/api/psx
# Backend proxy base. EMPTY ON PURPOSE = same origin: the app then requests
# /api/auth/me, /api/psx/api/v1/..., /api/cs/... on whatever host the page was served
# from, and frontend/nginx/nginx.conf proxies /api/ to the `proxy-prod` service.
#
# This must be empty (not an absolute URL). The previous value,
# http://169.58.108.61:6101, is baked into the bundle at build time, so from an https
# domain every call died before it left the browser — mixed content, then no CORS
# match, then (had it got that far) the container's CSP `connect-src 'self'`.
# Same-origin answers all three at once and keeps the image domain-agnostic.
#
# `??` only falls back on null/undefined, so the empty string wins over the
# http://localhost:4000 default in the source.
VITE_PROXY_BASE_URL=
